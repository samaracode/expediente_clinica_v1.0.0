# ==========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (ZOE)
# ==========================================

# --- Backend Config ---
# Desarrollo local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zoe_clinic
# Producción con Neon (Postgres serverless). Usar el endpoint -pooler y SSL:
#   DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/zoe_clinic?sslmode=require
SECRET_KEY=supersecretkeythatshouldbechangedinproduction123!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes CORS permitidos (frontend), coma-separados.
# En producción agregar la URL de Vercel:
#   CORS_ORIGINS=https://zoe-clinic.vercel.app
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# --- Almacenamiento de archivos ---
# STORAGE_BACKEND: "local" (disco, desarrollo) o "s3" (S3/R2, producción)
STORAGE_BACKEND=local

# Credenciales S3-compatibles (AWS S3 o Cloudflare R2)
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=zoe-clinic-files
# Dejar vacío para AWS S3 estándar.
# Para Cloudflare R2, usar el endpoint de tu cuenta:
#   S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=

# --- Frontend Config (admin/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
