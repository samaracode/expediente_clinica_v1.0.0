# ==============================================================================
# Expediente Clínico ZOE - Root .gitignore
# ==============================================================================

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.classpath
.settings/

# ==============================================================================
# Backend (Python / FastAPI / Alembic)
# ==============================================================================
backend/venv/
backend/.venv/
backend/env/
backend/ENV/
backend/dist/
backend/build/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
backend/app/db/*.db
backend/app/db/*.sqlite

# ==============================================================================
# Frontend (Next.js / Node.js)
# ==============================================================================
admin/node_modules/
admin/.next/
admin/out/
admin/build/
admin/dist/
admin/.docusaurus/
admin/.cache/
admin/npm-debug.log*
admin/yarn-debug.log*
admin/yarn-error.log*
admin/.pnpm-debug.log*
admin/*.tsbuildinfo

# ==============================================================================
# Environment / Secret Files (NEVER COMMIT SENSITIVE DATA)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# ==============================================================================
# Database & Office Temp Files
# ==============================================================================
# Ignore lock/temporary files generated by Microsoft Access (.accdb)
*.laccdb
# Temporary Office files
~$*
